# Copy to .env and adjust for your environment

# External URL of this app — used to build the Audible OAuth redirect URI
# For local dev: http://localhost:8080
# For home server: http://mynas.local:8080 or http://192.168.1.100:8080
APP_URL=http://localhost:8080

# Go backend
PORT=8080
DATABASE_PATH=./data/libation.db
OUTPUT_DIR=./data/audiobooks
DOWNLOAD_WORKERS=3

# Python sidecar (only needed if running outside Docker)
AUDIBLE_SVC_URL=http://localhost:8081
ACCOUNTS_DIR=./data/accounts
