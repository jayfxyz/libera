# Copy to .env and adjust for your environment

# External URL of this app (shown in Settings)
APP_URL=http://localhost:8888

# Docker: host port to serve the app on
PORT=8888

# Docker: host folder for the database and Audible login tokens
DATA_DIR=./data

# Docker: host folder downloads are written to, and the user/group that owns
# the files (match the owner of that folder, e.g. `id -u` / `id -g`)
AUDIOBOOKS_DIR=./data/audiobooks
PUID=1000
PGID=1000
