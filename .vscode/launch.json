{
  "version": "0.2.0",
  "configurations": [
    {
      // API + WebSocket on :8080. Run the frontend with `npm run dev` in
      // frontend/; Vite proxies /api and /ws here.
      "name": "Python: Launch server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8080"],
      "cwd": "${workspaceFolder}/server",
      "env": {
        "DATABASE_PATH": "${workspaceFolder}/data/db/libera.db",
        "ACCOUNTS_DIR": "${workspaceFolder}/data/accounts",
        "OUTPUT_DIR": "${workspaceFolder}/data/audiobooks"
      },
      "justMyCode": false
    },
    {
      // Start the server with debugpy yourself:
      //   cd server && python -m debugpy --listen 5678 -m uvicorn app.main:app --port 8080
      "name": "Python: Attach to server (debugpy :5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}/server", "remoteRoot": "." }],
      "justMyCode": false
    }
  ]
}
