{
  "version": "0.2.0",
  "configurations": [
    // ── Go backend ─────────────────────────────────────────────────────────
    {
      "name": "Go: Launch Backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/server",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PORT": "8080",
        "AUDIBLE_SVC_URL": "http://localhost:8081"
      }
    },
    {
      // Start backend manually with Delve:
      //   cd backend && dlv debug --headless --listen=:2345 --api-version=2 ./cmd/server
      "name": "Go: Attach to Backend (Delve :2345)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345
    },

    // ── FastAPI sidecar ────────────────────────────────────────────────────
    {
      "name": "Python: Launch FastAPI Sidecar",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8081"],
      "cwd": "${workspaceFolder}/audible-svc",
      "jinja": true,
      "justMyCode": false
    },
    {
      // Start sidecar manually with debugpy:
      //   cd audible-svc && python -m debugpy --listen 5678 -m uvicorn main:app --host 0.0.0.0 --port 8081
      "name": "Python: Attach to FastAPI Sidecar (debugpy :5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/audible-svc",
          "remoteRoot": "."
        }
      ],
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Launch: Backend + FastAPI Sidecar",
      "configurations": [
        "Go: Launch Backend",
        "Python: Launch FastAPI Sidecar"
      ],
      "stopAll": true
    }
  ]
}
